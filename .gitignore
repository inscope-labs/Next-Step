# Go build artifacts
/engine/bin/
*.exe
*.test
*.out

# root/workspace/ (singular) holds both runtime state and committed
# reference material, side by side. There is no separate root/workspaces/
# (plural) directory — an earlier build-plan draft called for one and it
# briefly existed in this repo; that was an error, corrected here.
#
# Runtime-only, never committed: live claimed-workspace instances at
# root/workspace/<ID>/, and the atomic-claim registry at
# root/workspace/registry/<ID>/. Ground truth path per
# root/protocol/v1.0/spec/PROTOCOL-FACTS.md.
#
# Committed reference material, not runtime state, despite living under
# the same top-level dir: templates/, docs/, legacy/.
root/workspace/*
!root/workspace/registry/
root/workspace/registry/*
!root/workspace/registry/.gitkeep
!root/workspace/templates/
!root/workspace/docs/
!root/workspace/legacy/

# Default-workspace pointer file read by run-task.sh/build-task.sh when
# --workspace is omitted (PROTOCOL-FACTS.md). Pure runtime state.
root/sessions/active

# Global task sequence counter and its lock file. Ground truth per
# PROTOCOL-FACTS.md: single shared $NEXT_STEP_HOME/.task-seq, not
# per-workspace.
root/.task-seq
root/.task-seq.lock

root/sessions/runtime/*
!root/sessions/runtime/.gitkeep
!root/sessions/runtime/Dockerfile.scratch
!root/sessions/runtime/sandbox-profile.json
root/sessions/entrypoint/*
!root/sessions/entrypoint/.gitkeep

# OS / editor cruft
.DS_Store
*.swp

PROTOCOL_VERSION=1.0
TASK_ID={{TASK_ID}}
TASK_VERSION=1
CREATED_AT={{TIMESTAMP}}
CREATED_BY=AI
WORKSPACE_ID={{WORKSPACE_ID}}
TASK_INTENT=Onboarding demo: write a single file inside the workspace at $NEXT_STEP_WORKSPACE_ROOT/files/next-step-onboarding-demo.txt containing the human-specified scope content, and verify it independently.
TASK_CONTENT_HASH=PENDING
WRITE_PATHS=files/next-step-onboarding-demo.txt
IDEMPOTENCY_MODE=SAFE
EXECUTION_CONTEXT=ANDROID_TERMUX_HOME
ALLOW_NETWORK=false
ALLOW_DESTRUCTIVE=false
ALLOW_REMOTE_EXEC=false
ALLOW_PRIVILEGED=false
ALLOW_CREDENTIAL_ACCESS=false
ALLOW_PROCESS_CONTROL=false
REQUIRE_CLEAN_WORKING_DIR=false
INTERRUPTION_POLICY=SAFE_TO_INTERRUPT_ANY_POINT
